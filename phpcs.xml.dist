<?xml version="1.0"?>
<ruleset name="EuTeAjudo">
	<description>WordPress Coding Standards and PHP 8.5 compatibility for the EuTeAjudo plugin and theme.</description>

	<file>plugin</file>
	<file>theme</file>
	<file>tests</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>theme/assets/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="parallel" value="8"/>

	<config name="testVersion" value="8.5-"/>
	<config name="minimum_wp_version" value="7.1"/>

	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress">
		<!-- Classes follow PSR-4 file names (Plugin.php), not class-plugin.php. -->
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="euteajudo"/>
				<element value="euteajudo-theme"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="euteajudo"/>
				<element value="EuTeAjudo"/>
			</property>
		</properties>
	</rule>

	<!-- Test method names are descriptive sentences; their docblocks would only repeat them. -->
	<rule ref="Squiz.Commenting.FunctionComment.Missing">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<!-- Test bootstrap and config define WordPress test-suite globals and constants by design. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>tests/wp-tests-config.php</exclude-pattern>
		<exclude-pattern>tests/bootstrap-integration.php</exclude-pattern>
	</rule>
	<!-- Tests set environment variables (e.g. OAuth credentials) on purpose. -->
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.runtime_configuration_putenv">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
</ruleset>
