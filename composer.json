{
	"name": "euteajudo/platform",
	"description": "EuTeAjudo.org WordPress plugin and theme: development tooling.",
	"license": "GPL-2.0-or-later",
	"type": "project",
	"require": {
		"php": ">=8.5"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpcompatibility/php-compatibility": "^10.0@alpha",
		"phpcompatibility/phpcompatibility-paragonie": "^2.0@alpha",
		"phpcompatibility/phpcompatibility-wp": "^3.0@alpha",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.1",
		"phpstan/phpstan-phpunit": "^2.1",
		"phpunit/phpunit": "^9.6",
		"squizlabs/php_codesniffer": "^3.13",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-coding-standards/wpcs": "^3.1",
		"wp-phpunit/wp-phpunit": "^7.1",
		"yoast/phpunit-polyfills": "^4.0"
	},
	"autoload-dev": {
		"psr-4": {
			"EuTeAjudo\\": "plugin/src/",
			"EuTeAjudo\\Tests\\": "tests/"
		}
	},
	"config": {
		"platform": {
			"php": "8.5.12"
		},
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		}
	},
	"scripts": {
		"test:unit": "phpunit -c phpunit-unit.xml.dist",
		"test:integration": "phpunit -c phpunit-integration.xml.dist",
		"test": [
			"@test:unit",
			"@test:integration"
		],
		"phpcs": "phpcs",
		"phpcbf": "phpcbf",
		"phpstan": "phpstan analyse --memory-limit=1G",
		"lint": [
			"@phpcs",
			"@phpstan"
		],
		"i18n": [
			"php -d error_reporting=24575 /usr/local/bin/wp --path=wordpress i18n make-pot plugin plugin/languages/euteajudo.pot --domain=euteajudo --skip-js",
			"php -d error_reporting=24575 /usr/local/bin/wp --path=wordpress i18n update-po plugin/languages/euteajudo.pot plugin/languages",
			"php -d error_reporting=24575 /usr/local/bin/wp --path=wordpress i18n make-mo plugin/languages",
			"php -d error_reporting=24575 /usr/local/bin/wp --path=wordpress i18n make-pot theme theme/languages/euteajudo.pot --domain=euteajudo --skip-js",
			"php -d error_reporting=24575 /usr/local/bin/wp --path=wordpress i18n update-po theme/languages/euteajudo.pot theme/languages",
			"php -d error_reporting=24575 /usr/local/bin/wp --path=wordpress i18n make-mo theme/languages"
		]
	}
}
