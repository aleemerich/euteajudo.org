{
  "$description": "EuTeAjudo.org design tokens, identity 'Luz acesa'. Format: Design Tokens Community Group (DTCG). Source of truth for theme.json and promotional material. Color modes: 'night' (default when the device preference is dark or unknown) and 'day' (device preference light). A choice made by the visitor overrides the device.",
  "color": {
    "night": {
      "$type": "color",
      "background": { "$value": "#0F2529", "$description": "Noite: page background" },
      "surface": { "$value": "#16343B", "$description": "Madrugada: cards, replies" },
      "field": { "$value": "#1B3D44", "$description": "Text fields: a little lighter than the page, so they read as places to write" },
      "field-border": { "$value": "#7A9692", "$description": "Field borders: 5.0:1 on the page, 3.7:1 on the field (WCAG 1.4.11)" },
      "text": { "$value": "#E9EFEC", "$description": "Luar: body text" },
      "text-strong": { "$value": "#FFFFFF", "$description": "Headings" },
      "text-muted": { "$value": "#9BB1AD", "$description": "Neblina: secondary text" },
      "line": { "$value": "#24444B", "$description": "Dividers, card borders" },
      "line-strong": { "$value": "#3A5C63", "$description": "Field borders" },
      "accent": { "$value": "#F2B13B", "$description": "Luminária: buttons, new reply, active tab" },
      "on-accent": { "$value": "#1E1503", "$description": "Text on accent" },
      "focus": { "$value": "#F2B13B", "$description": "Keyboard focus ring" },
      "notice-text": { "$value": "#F6CD78", "$description": "'New reply' label, thanks text" },
      "thanks-background": { "$value": "#3B3216", "$description": "'Isso me ajudou' pressed" }
    },
    "day": {
      "$type": "color",
      "background": { "$value": "#EEF3F1", "$description": "Dia: page background" },
      "surface": { "$value": "#FFFFFF" },
      "field": { "$value": "#FFFFFF" },
      "field-border": { "$value": "#738884", "$description": "3.4:1 on the page, 3.8:1 on the field (WCAG 1.4.11)" },
      "text": { "$value": "#10262A" },
      "text-strong": { "$value": "#0A1B1E" },
      "text-muted": { "$value": "#4A625E" },
      "line": { "$value": "#D3DEDB" },
      "line-strong": { "$value": "#B3C5C0" },
      "accent": { "$value": "#F2B13B" },
      "on-accent": { "$value": "#1E1503" },
      "focus": { "$value": "#0F2529", "$description": "Amber on light background lacks contrast for a focus ring" },
      "notice-text": { "$value": "#7A4E00" },
      "thanks-background": { "$value": "#FCEBC5" }
    },
    "brand": {
      "$type": "color",
      "lamp": { "$value": "#F2B13B", "$description": "The lit window. Same in both modes." },
      "lamp-light": { "$value": "#F8C866", "$description": "Top of the lit window gradient" },
      "lamp-deep": { "$value": "#E59A22", "$description": "Bottom of the lit window gradient" },
      "night": { "$value": "#0F2529" },
      "moon": { "$value": "#E9EFEC" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "base": { "$value": ["Atkinson Hyperlegible Next", "system-ui", "sans-serif"], "$description": "Only family. Self-hosted woff2 in design/fonts/web, never loaded from third-party servers." }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "size": {
      "$type": "dimension",
      "small": { "$value": "0.85rem" },
      "body": { "$value": "1.0625rem", "$description": "17px base" },
      "h2": { "$value": "1.25rem" },
      "h1": { "$value": "1.75rem", "$description": "2.2rem on wide screens" },
      "display": { "$value": "2.3rem", "$description": "3.6rem on wide screens; home hero only" }
    },
    "line-height": {
      "$type": "number",
      "body": { "$value": 1.55 },
      "heading": { "$value": 1.15 }
    }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" }
  },
  "radius": {
    "$type": "dimension",
    "field": { "$value": "12px" },
    "button": { "$value": "12px" },
    "card": { "$value": "16px" },
    "panel": { "$value": "18px" }
  },
  "size": {
    "$type": "dimension",
    "touch-target": { "$value": "48px", "$description": "Minimum height of buttons and tappable rows" },
    "content-width": { "$value": "720px", "$description": "Reading column on wide screens" },
    "wide-width": { "$value": "1120px", "$description": "Home page on wide screens" }
  },
  "shadow": {
    "lamp-glow": { "$type": "shadow", "$value": { "color": "#F2B13B6B", "offsetX": "0px", "offsetY": "0px", "blur": "30px", "spread": "8px" }, "$description": "Only for the lit window. No other element glows." }
  }
}
